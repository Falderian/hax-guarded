# Maintainer: Falderian
# Fork of the hax AUR package for the guardrails-policy branch. The upstream package is `hax`,
# maintained by the original author; this one keeps its own name so the two can never be confused.
pkgname=hax-guarded-git
pkgver=0.6.1.bfefd1e
pkgrel=1
pkgdesc="Minimalist, terminal-native coding agent written in C, with a config-driven tool-call policy"
arch=('x86_64' 'aarch64')
url="https://github.com/Falderian/hax-guarded"
license=('MIT')
depends=('curl' 'jansson')
makedepends=('git' 'meson' 'ninja' 'gcc')
provides=('hax')
conflicts=('hax' 'hax-bin' 'hax-git')
source=("$pkgname::git+https://github.com/Falderian/hax-guarded.git#branch=guardrails-policy")
sha256sums=('SKIP')

pkgver() {
    cd "$srcdir/$pkgname"
    local tag
    tag=$(git describe --tags --abbrev=0 2>/dev/null | sed 's/^v//')
    printf '%s.%s' "${tag:-0}" "$(git rev-parse --short HEAD)"
}

build() {
    cd "$srcdir/$pkgname"
    meson setup build --prefix=/usr --buildtype=release
    meson compile -C build
}

check() {
    cd "$srcdir/$pkgname"
    meson test -C build --print-errorlogs
}

package() {
    cd "$srcdir/$pkgname"
    meson install -C build --destdir "$pkgdir"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
